@model FranchiseVerse.Models.Movie
@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = Model.Title;
}

<link rel="stylesheet" href="~/css/movie_page.css" asp-append-version="true" />

<div class="movie-details-container">
    <div class="movie-poster">
        <img src="@Model.PosterUrl" alt="Постер @Model.Title" />
    </div>
    <div class="movie-info">
        <h1>@Model.Title</h1>
        <p class="movie-full-description">@Model.Description</p>
        <div class="movie-meta">
            <p>Рейтинг Кинопоиска: @Model.Rating</p>
            <p>Пользовательский рейтинг: @(Model.OurRate > 0 ? $"{Model.OurRate:F1}" : "Нет оценок")</p>
            <p>Жанр: @Model.Genre</p>
            <p>Год выхода: @(Model.ReleaseDate?.Year)</p>
        </div>
    </div>
</div>

<!-- Система оценок -->
@if (User.Identity.IsAuthenticated)
{
    <form asp-controller="Movie" asp-action="Rate" method="post" class="rating-form">
        @Html.AntiForgeryToken() <!-- CSRF защита -->
        <input type="hidden" name="id" value="@Model.Id" />

        <h4>Оцените фильм:</h4>
        <div class="rating-stars">

            @for (int i = 1; i <= 10; i++)
            {
                <label class="star-label @(ViewBag.UserRating == i ? "active" : "")">
                    <input type="radio" name="rating" value="@i" @(ViewBag.UserRating == i ? "checked" : "") />
                    @i ⭐
                </label>
            }

        </div>

        <button type="submit" class="btn btn-primary mt-2">Сохранить</button>
    </form>
}
else
{
    <p class="text-muted">Авторизуйтесь, чтобы оставить оценку.</p>
}

<a asp-action="Index" class="back-link">Назад к списку фильмов</a>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const labels = document.querySelectorAll('.star-label');

            labels.forEach(label => {
                label.addEventListener('click', function () {
                    // Удаляем active у всех
                    labels.forEach(l => l.classList.remove('active'));
                    // Добавляем active текущей
                    this.classList.add('active');
                });
            });
        });
    </script>
}