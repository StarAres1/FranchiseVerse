@model IEnumerable<FranchiseVerse.Models.Movie>

@{
    ViewData["Title"] = "Список фильмов";
}

<link rel="stylesheet" href="~/css/movie_page.css" asp-append-version="true" />

<h2>Список фильмов</h2>

<div class="movie-list">
    @foreach (var movie in Model)
    {
        <div class="movie-tile">
            <a asp-action="Details" asp-route-id="@movie.Id" class="movie-link">
                <div class="movie-tile__wrapper">
                    <div class="movie-poster">
                        <img src="@movie.PosterUrl" alt="Постер фильма @movie.Title" />
                    </div>
                    <div class="movie-info">
                        <h3 class="movie-title">@movie.Title</h3>
                        <p class="movie-description">
                            @(movie.Description?.Length > 100 ? movie.Description.Substring(0, 100) + "..." : movie.Description)
                        </p>
                        <div class="movie-details">
                            <span class="movie-detail">Рейтинг Кинопоиска: @movie.Rating</span>
                            <span class="movie-detail">Жанр: @movie.Genre</span>
                            <span class="movie-detail">Год выхода: @(movie.ReleaseDate?.Year)</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

<div class="pagination">
    @if (ViewBag.TotalPages > 1)
    {
        int currentPage = ViewBag.Page;
        int totalPages = ViewBag.TotalPages;
        int maxButtons = 20; // Максимальное количество кнопок

        <nav aria-label="Page navigation">
            <ul class="pagination">
                @if (totalPages <= maxButtons)
                {
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="?page=@i">@i</a>
                        </li>
                    }
                }
                else
                {
                    int startPage = Math.Max(1, currentPage - (maxButtons / 2));
                    int endPage = Math.Min(totalPages, startPage + maxButtons - 1);

                    // Корректировка диапазона, если он выходит за границы
                    if (endPage - startPage + 1 < maxButtons)
                    {
                        startPage = Math.Max(1, endPage - maxButtons + 1);
                    }

                    // Первые страницы
                    if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?page=1">1</a>
                        </li>
                        if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }

                    // Текущая область
                    for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="?page=@i">@i</a>
                        </li>
                    }

                    // Последние страницы
                    if (endPage < totalPages)
                    {
                        if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link" href="?page=@totalPages">@totalPages</a>
                        </li>
                    }
                }
            </ul>
        </nav>
    }
</div>