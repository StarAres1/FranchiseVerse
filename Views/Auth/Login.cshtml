@model FranchiseVerse.Models.LoginDto

<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
<div class="form-container">
    <h2>Авторизация</h2>
    <form asp-action="Login" method="post" class="styled-form">
        <div class="form-group">
            <label asp-for="UserName">Логин:</label>
            <input asp-for="UserName" class="form-input" />
        </div>
        <div class="form-group">
            <label asp-for="Password">Пароль:</label>
            <input type="password" asp-for="Password" class="form-input" />
        </div>
        <button type="submit" class="btn">Войти</button>
    </form>
</div>
